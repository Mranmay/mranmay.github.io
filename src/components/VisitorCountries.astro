<div class="shell countries" id="visitor-countries" hidden>
  <div class="country-heading">
    <span>Visitors by country</span>
    <div id="country-highlights" aria-live="polite"></div>
  </div>
  <details id="country-details" hidden>
    <summary>All countries</summary>
    <ul id="country-list" aria-label="Visits by country"></ul>
    <p class="note">Visits since November 2026 · counted once per browser per day. Locations are approximate.</p>
  </details>
  <span id="country-tooltip" aria-hidden="true" hidden></span>
</div>

<style>
  .countries { border-top: 1px solid var(--rule); padding-block: .75rem 1.2rem; font-size: .875rem; }
  .country-heading, #country-highlights { display: flex; align-items: center; flex-wrap: wrap; gap: .2rem .7rem; }
  .country-heading > span { font-weight: 600; }
  #country-highlights { gap: .1rem .3rem; color: var(--muted); }
  details { margin-top: .25rem; }
  summary { color: var(--accent); cursor: pointer; width: fit-content; }
  #country-list {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(3.5rem, 1fr));
    gap: .1rem .2rem; margin: .45rem 0; padding: .15rem; list-style: none;
  }
  .countries :global(.country-cell) {
    display: inline-flex; align-items: center; gap: .25rem; min-height: 1.6rem;
    border: 0; border-radius: .25rem; padding: .1rem .2rem; background: transparent;
    color: var(--muted); font: inherit; font-size: .8125rem; font-variant-numeric: tabular-nums;
  }
  .countries :global(.country-cell:hover), .countries :global(.country-cell:focus-visible) {
    background: var(--panel); color: var(--ink);
  }
  .countries :global(.country-cell:focus-visible) { outline-offset: 0; }
  .countries :global(.country-flag) {
    display: inline-block; width: 20px; height: 15px; border-radius: 1px;
    background: url("/images/country-flags.webp") no-repeat; background-size: 320px 240px;
  }
  #country-tooltip {
    position: fixed; z-index: 10; padding: .2rem .5rem; border: 1px solid var(--rule);
    background: var(--panel); color: var(--ink); border-radius: .3rem; font-size: .8125rem;
    line-height: 1.4; max-width: calc(100vw - 1rem); pointer-events: none;
  }
  .note { margin: .45rem 0 0; color: var(--muted); font-size: .8125rem; }
  @media (max-width: 42rem) {
    #country-list { max-height: min(15rem, 40vh); overflow-y: auto; }
  }
  @media (pointer: coarse) {
    .countries :global(.country-cell) { min-height: 2rem; min-width: 2.65rem; }
  }
</style>

<script>
  const root = document.getElementById("visitor-countries")!;
  const highlights = document.getElementById("country-highlights")!;
  const details = document.querySelector<HTMLDetailsElement>("#country-details")!;
  const list = document.getElementById("country-list")!;
  const endpoint = "https://mranmay-visitor-countries.snappy-spoon-2762.chatgpt.site/countries";
  const countryCodes = "AD AE AF AG AI AL AM AO AQ AR AS AT AU AW AX AZ BA BB BD BE BF BG BH BI BJ BL BM BN BO BQ BR BS BT BV BW BY BZ CA CC CD CF CG CH CI CK CL CM CN CO CR CU CV CW CX CY CZ DE DJ DK DM DO DZ EC EE EG EH ER ES ET FI FJ FK FM FO FR GA GB GD GE GF GG GH GI GL GM GN GP GQ GR GS GT GU GW GY HK HM HN HR HT HU ID IE IL IM IN IO IQ IR IS IT JE JM JO JP KE KG KH KI KM KN KP KR KW KY KZ LA LB LC LI LK LR LS LT LU LV LY MA MC MD ME MF MG MH MK ML MM MN MO MP MQ MR MS MT MU MV MW MX MY MZ NA NC NE NF NG NI NL NO NP NR NU NZ OM PA PE PF PG PH PK PL PM PN PR PS PT PW PY QA RE RO RS RU RW SA SB SC SD SE SG SH SI SJ SK SL SM SN SO SR SS ST SV SX SY SZ TC TD TF TG TH TJ TK TL TM TN TO TR TT TV TW TZ UA UG UM US UY UZ VA VC VE VG VI VN VU WF WS XK YE YT ZA ZM ZW".split(" ");
  type Row = { country: string; visits: number };

  // Rotate the random key daily. The counting service never needs a stable identifier.
  function dailyKey() {
    const key = "portfolio.visitor-day";
    const day = new Date().toISOString().slice(0, 10);
    let saved = localStorage.getItem(key);
    if (!saved?.startsWith(day + "/")) {
      saved = day + "/" + crypto.randomUUID();
      localStorage.setItem(key, saved);
    }
    return saved.slice(day.length + 1);
  }

  const tooltip = document.getElementById("country-tooltip")!;
  const compactCount = new Intl.NumberFormat("en", { notation: "compact" });

  function flagButton(code: string, name: string, visits: number) {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "country-cell";
    button.dataset.countryName = name;
    button.setAttribute("aria-label", `${name}, ${visits.toLocaleString()} ${visits === 1 ? "visit" : "visits"}`);
    const flag = document.createElement("span");
    const index = countryCodes.indexOf(code);
    if (index >= 0) {
      flag.className = "country-flag";
      flag.style.backgroundPosition = `${-(index % 16) * 20}px ${-Math.floor(index / 16) * 15}px`;
    } else {
      flag.textContent = "🌐";
    }
    flag.setAttribute("aria-hidden", "true");
    button.append(flag, visits >= 1000 ? compactCount.format(visits) : String(visits));
    return button;
  }

  function cellAt(target: EventTarget | null) {
    return target instanceof Element ? target.closest<HTMLButtonElement>(".country-cell") : null;
  }

  function reveal(button: HTMLButtonElement) {
    tooltip.textContent = button.dataset.countryName || "";
    tooltip.hidden = false;
    const cell = button.getBoundingClientRect();
    const label = tooltip.getBoundingClientRect();
    const left = cell.left + (cell.width - label.width) / 2;
    tooltip.style.left = Math.max(6, Math.min(left, document.documentElement.clientWidth - label.width - 6)) + "px";
    tooltip.style.top = (cell.top >= label.height + 6 ? cell.top - label.height - 4 : cell.bottom + 4) + "px";
  }

  function dismiss() { tooltip.hidden = true; }
  root.addEventListener("pointerover", event => {
    const button = cellAt(event.target);
    if (event.pointerType === "mouse" && button && button !== cellAt(event.relatedTarget)) reveal(button);
  });
  root.addEventListener("pointerout", event => {
    if (event.pointerType === "mouse" && cellAt(event.target) !== cellAt(event.relatedTarget)) dismiss();
  });
  root.addEventListener("focusin", event => {
    const button = cellAt(event.target);
    if (button) reveal(button);
  });
  root.addEventListener("focusout", dismiss);
  document.addEventListener("click", event => {
    const button = cellAt(event.target);
    if (button) reveal(button);
    else dismiss();
  });
  root.addEventListener("keydown", event => { if (event.key === "Escape") dismiss(); });
  // The label is positioned in the viewport, outside the scrollable mobile grid.
  document.addEventListener("scroll", () => { if (!tooltip.hidden) dismiss(); }, { capture: true, passive: true });
  window.addEventListener("resize", dismiss);

  function show(countries: Row[]) {
    const counts = new Map(countries.map(r => [r.country, r.visits]));
    const names = new Intl.DisplayNames(["en"], { type: "region" });
    const name = (code: string) => code === "XX" ? "Unknown location" : names.of(code) || code;
    highlights.replaceChildren(...countries.slice(0, 4).map(({ country, visits }) => flagButton(country, name(country), visits)));
    if (!countries.length) highlights.textContent = "No visits recorded yet.";
    details.hidden = false;
    details.addEventListener("toggle", () => {
      dismiss();
      if (!details.open || list.childElementCount) return;
      const codes = [...new Set([...countryCodes, ...counts.keys()])];
      codes.sort((a, b) => (counts.get(b) || 0) - (counts.get(a) || 0) || name(a).localeCompare(name(b), "en"));
      const fragment = document.createDocumentFragment();
      for (const code of codes) {
        const item = document.createElement("li");
        item.append(flagButton(code, name(code), counts.get(code) || 0));
        fragment.append(item);
      }
      list.append(fragment);
    });
  }

  async function loadCountries() {
    root.hidden = false;
    highlights.textContent = "Loading counts…";
    let token = "";
    if (location.origin === "https://mranmay.github.io") {
      try {
        token = navigator.locks ? await navigator.locks.request("portfolio-visitor-key", dailyKey) : dailyKey();
      } catch { /* Read totals when storage is unavailable. */ }
    }
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 8000);
    try {
      const response = await fetch(endpoint, {
        method: token ? "POST" : "GET", body: token || undefined,
        credentials: "omit", referrerPolicy: "no-referrer", signal: controller.signal,
      });
      if (!response.ok) throw new Error();
      const { countries } = await response.json();
      if (!Array.isArray(countries)) throw new Error();
      show(countries);
    } catch {
      highlights.textContent = "Counts temporarily unavailable.";
    } finally {
      window.clearTimeout(timeout);
    }
  }

  function schedule() {
    if ("requestIdleCallback" in window) window.requestIdleCallback(loadCountries, { timeout: 1500 });
    else globalThis.setTimeout(loadCountries, 100);
  }
  if (document.readyState === "complete") schedule();
  else window.addEventListener("load", schedule, { once: true });
</script>
