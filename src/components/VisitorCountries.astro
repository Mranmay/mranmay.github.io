<div class="shell countries" id="visitor-countries" hidden>
  <div class="country-heading">
    <span>Visitors by country</span>
    <p id="country-highlights" aria-live="polite"></p>
  </div>
  <details id="country-details" hidden>
    <summary>All countries</summary>
    <p class="note">Visits since November 2026 · counted once per browser per day. Locations are approximate.</p>
    <ul id="country-list"></ul>
  </details>
</div>

<style>
  .countries { border-top: 1px solid var(--rule); padding-block: 1.1rem 1.8rem; font-size: .9rem; }
  .country-heading { display: flex; align-items: baseline; flex-wrap: wrap; column-gap: 1.25rem; row-gap: .35rem; }
  .country-heading > span { font-weight: 600; }
  .countries p { margin: 0; color: var(--muted); }
  #country-highlights { display: flex; gap: .35rem 1rem; flex-wrap: wrap; min-height: 1.3em; }
  details { margin-top: .55rem; }
  summary { color: var(--accent); cursor: pointer; width: fit-content; }
  .countries .note { margin-top: .8rem; }
  ul { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); gap: .5rem 2rem; padding: 0; margin: 1rem 0 0; }
  ul :global(li) { display: flex; align-items: baseline; justify-content: space-between; gap: .6rem; border-bottom: 1px solid var(--rule); padding-block: .3rem; }
  ul :global(li span:last-child) { font-variant-numeric: tabular-nums; color: var(--muted); }
</style>

<script>
  const root = document.getElementById("visitor-countries")!;
  const highlights = document.getElementById("country-highlights")!;
  const details = document.querySelector<HTMLDetailsElement>("#country-details")!;
  const list = document.getElementById("country-list")!;
  const endpoint = "https://mranmay-visitor-countries.snappy-spoon-2762.chatgpt.site/countries";
  const countryCodes = "AD AE AF AG AI AL AM AO AQ AR AS AT AU AW AX AZ BA BB BD BE BF BG BH BI BJ BL BM BN BO BQ BR BS BT BV BW BY BZ CA CC CD CF CG CH CI CK CL CM CN CO CR CU CV CW CX CY CZ DE DJ DK DM DO DZ EC EE EG EH ER ES ET FI FJ FK FM FO FR GA GB GD GE GF GG GH GI GL GM GN GP GQ GR GS GT GU GW GY HK HM HN HR HT HU ID IE IL IM IN IO IQ IR IS IT JE JM JO JP KE KG KH KI KM KN KP KR KW KY KZ LA LB LC LI LK LR LS LT LU LV LY MA MC MD ME MF MG MH MK ML MM MN MO MP MQ MR MS MT MU MV MW MX MY MZ NA NC NE NF NG NI NL NO NP NR NU NZ OM PA PE PF PG PH PK PL PM PN PR PS PT PW PY QA RE RO RS RU RW SA SB SC SD SE SG SH SI SJ SK SL SM SN SO SR SS ST SV SX SY SZ TC TD TF TG TH TJ TK TL TM TN TO TR TT TV TW TZ UA UG UM US UY UZ VA VC VE VG VI VN VU WF WS XK YE YT ZA ZM ZW".split(" ");
  type Row = { country: string; visits: number };

  // Rotate the random key daily. The counting service never needs a stable identifier.
  function dailyKey() {
    const key = "portfolio.visitor-day";
    const day = new Date().toISOString().slice(0, 10);
    let saved = localStorage.getItem(key);
    if (!saved?.startsWith(day + "/")) {
      saved = day + "/" + crypto.randomUUID();
      localStorage.setItem(key, saved);
    }
    return saved.slice(day.length + 1);
  }

  function show(countries: Row[]) {
    const counts = new Map(countries.map(r => [r.country, r.visits]));
    const names = new Intl.DisplayNames(["en"], { type: "region" });
    const name = (code: string) => code === "XX" ? "Unknown location" : names.of(code) || code;
    const label = (code: string) => {
      const span = document.createElement("span");
      if (code !== "XX") {
        const flag = document.createElement("span");
        flag.setAttribute("aria-hidden", "true");
        flag.textContent = String.fromCodePoint(...Array.from(code, c => 127397 + c.charCodeAt(0))) + " ";
        span.append(flag);
      }
      span.append(name(code));
      return span;
    };
    highlights.replaceChildren(...countries.slice(0, 4).map(({ country, visits }) => {
      const item = label(country);
      item.append(" " + visits.toLocaleString());
      return item;
    }));
    if (!countries.length) highlights.textContent = "No visits recorded yet.";
    details.hidden = false;
    details.addEventListener("toggle", () => {
      if (!details.open || list.childElementCount) return;
      const codes = [...new Set([...countryCodes, ...counts.keys()])];
      codes.sort((a, b) => (counts.get(b) || 0) - (counts.get(a) || 0) || name(a).localeCompare(name(b), "en"));
      const fragment = document.createDocumentFragment();
      for (const country of codes) {
        const row = document.createElement("li");
        const count = document.createElement("span");
        count.textContent = (counts.get(country) || 0).toLocaleString();
        row.append(label(country), count);
        fragment.append(row);
      }
      list.append(fragment);
    });
  }

  async function loadCountries() {
    root.hidden = false;
    highlights.textContent = "Loading counts…";
    let token = "";
    if (location.origin === "https://mranmay.github.io") {
      try {
        token = navigator.locks ? await navigator.locks.request("portfolio-visitor-key", dailyKey) : dailyKey();
      } catch { /* Read totals when storage is unavailable. */ }
    }
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 8000);
    try {
      const response = await fetch(endpoint, {
        method: token ? "POST" : "GET", body: token || undefined,
        credentials: "omit", referrerPolicy: "no-referrer", signal: controller.signal,
      });
      if (!response.ok) throw new Error();
      const { countries } = await response.json();
      if (!Array.isArray(countries)) throw new Error();
      show(countries);
    } catch {
      highlights.textContent = "Counts temporarily unavailable.";
    } finally {
      window.clearTimeout(timeout);
    }
  }

  function schedule() {
    if ("requestIdleCallback" in window) window.requestIdleCallback(loadCountries, { timeout: 1500 });
    else globalThis.setTimeout(loadCountries, 100);
  }
  if (document.readyState === "complete") schedule();
  else window.addEventListener("load", schedule, { once: true });
</script>
