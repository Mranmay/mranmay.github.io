---
import { rosslerResults } from "@/data/rossler-ccm.mjs";
const series = rosslerResults();
const x = (size: number) => 48 + 460 * (size - 50) / 950;
const y = (rho: number) => 172 - 145 * rho;
const format = (rho: number) => rho > .999 ? "> 0.999" : rho.toFixed(3);
---
<figure class="ccm">
  <figcaption><strong>Cross-map skill as the library grows</strong></figcaption>
  <p class="legend"><span>● Estimate x₁ from x₂ history</span><span>◇ Estimate x₂ from x₁ history</span></p>
  <svg viewBox="0 0 545 224" role="img" aria-label="Correlation against library size. Both directions approach one by 321 points.">
    {[0,.25,.5,.75,1].map(tick => <g><line x1="48" x2="508" y1={y(tick)} y2={y(tick)}/><text x="39" y={y(tick)+4} text-anchor="end">{tick}</text></g>)}
    <text x="8" y="14">ρ</text>
    {[50,321,728,1000].map(size => <text text-anchor="middle" x={x(size)} y="194">{size}</text>)}
    <text x="278" y="218" text-anchor="middle">Library size (points)</text>
    {series.map((fits, direction) => <g class={direction ? 'reverse' : 'forward'}>
      <polyline points={fits.map(f => x(f.size)+','+y(f.rho)).join(' ')} />
      {fits.map(f => direction
        ? <path d={`M${x(f.size)} ${y(f.rho)-5}l5 5-5 5-5-5z`}/>
        : <circle cx={x(f.size)} cy={y(f.rho)} r="3"/>)}
    </g>)}
    <line class="cursor" x1={x(50)} x2={x(50)} y1="18" y2="172"/>
  </svg>
  <label hidden>Inspect library size <select>{series[0].map(f => <option value={x(f.size)}>{f.size} points</option>)}</select></label>
  <div aria-live="polite">{series[0].map((f,i) => <p hidden={i!==0} data-reading>At {f.size} points · x₁ from x₂: <b>{format(f.rho)}</b> · x₂ from x₁: <b>{format(series[1][i].rho)}</b></p>)}</div>
</figure>
<script>
  for (const plot of document.querySelectorAll<HTMLElement>(".ccm")) {
    const select = plot.querySelector("select")!;
    const cursor = plot.querySelector(".cursor")!;
    function update() {
      for (const key of ["x1","x2"]) cursor.setAttribute(key,select.value);
      plot.querySelectorAll<HTMLElement>("[data-reading]").forEach((p,i) => p.hidden = i !== select.selectedIndex);
    }
    select.onchange = update;
    update();
    plot.querySelector("label")!.hidden = false;
  }
</script>
<style>
.ccm {padding:1rem; border:1px solid var(--rule); border-radius:.3rem; --a:#89c8ff; --b:#ffb276;}
:global([data-theme="light"]) .ccm {--a:#195c96;--b:#914210;}
.ccm figcaption {text-align:left;color:var(--ink);}
.ccm .legend {display:flex;flex-wrap:wrap;gap:.25rem 1rem;font-size:.95rem;}
.legend span:first-child {color:var(--a);}
.legend span:last-child {color:var(--b);}
svg {display:block;width:100%;}
text {fill:var(--muted);font:15px var(--body);}
line {stroke:var(--rule);}
.cursor {stroke:var(--muted);stroke-dasharray:2 4;}
.forward {stroke:var(--a);fill:var(--a);}
.reverse {stroke:var(--b);fill:none;}
polyline {fill:none;stroke-width:2;}
.reverse polyline {stroke-dasharray:5 4;}
.reverse path {stroke-width:1.5;}
select {background:var(--panel);color:var(--ink);padding:.5rem;border:1px solid var(--muted);border-radius:.3rem;}
.ccm [hidden] {display:none;}
.ccm [data-reading] {margin:.5rem 0 0;font-variant-numeric:tabular-nums;}
</style>
