---
import { NAV_LINKS } from "@/consts";
const current = Astro.url.pathname.split("/")[1];
---

<div class="shell masthead">
  <a class="wordmark" href="/" aria-label="Mranmay Shetty, home">
    <svg
      viewBox="0 0 32 32"
      width="32"
      height="32"
      fill="none"
      aria-hidden="true"
    >
      <g
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M4 23 11 17 16 17 20 11 27 6 M10 17 8 10 4 7 M16 17 20 23 26 26 M19 12 17 6 M20 23 20 28"
        ></path>
        <circle cx="16" cy="17" r="2.3" fill="currentColor"></circle>
      </g>
    </svg><span>Mranmay Shetty</span>
  </a>
  <nav aria-label="Main navigation">
    {
      NAV_LINKS.map(({ href, title }) => (
        <a
          href={href}
          class:list={["nav-link", { "cv-link": title === "CV" }]}
          aria-current={
            href.split("/")[1] === current
              ? href.replace(/\/$/, "") ===
                Astro.url.pathname.replace(/\/$/, "")
                ? "page"
                : "location"
              : undefined
          }
        >
          {title}
        </a>
      ))
    }
  </nav>
  <button
    id="theme-toggle"
    type="button"
    aria-label="Toggle light theme"
    aria-pressed="false"
    hidden
  >
    <svg
      viewBox="0 0 24 24"
      width="19"
      height="19"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <g class="sun"
        ><circle cx="12" cy="12" r="4"></circle><path
          d="M12 1v3m0 16v3M1 12h3m16 0h3M4 4l2 2m12 12 2 2M20 4l-2 2M6 18l-2 2"
        ></path></g
      >
      <path class="moon" d="M20 15A8.5 8.5 0 0 1 9 4a8.5 8.5 0 1 0 11 11Z"
      ></path>
    </svg>
  </button>
</div>
