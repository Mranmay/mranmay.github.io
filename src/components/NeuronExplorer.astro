---
import volumeUrl from "@/data/microns-volume.json?url";
---

<figure
  class="specimen"
  data-neuron
  data-volume={volumeUrl}
  aria-label="Interactive MICrONS mouse visual cortex reconstruction"
>
  <button
    type="button"
    class="stimulus"
    aria-label="Stimulate a neuron. Drag horizontally to rotate the reconstruction."
    disabled
  >
    <img
      class="volume-poster"
      src="/images/microns-field.webp"
      width="1152"
      height="729"
      alt=""
      fetchpriority="high"
    />
    <canvas class="volume-geometry" aria-hidden="true"></canvas>
    <canvas class="volume-activity" aria-hidden="true"></canvas>
  </button>
  <button
    type="button"
    class="playback"
    aria-label="Pause animation"
    title="Pause animation"
    hidden
  >
    <svg
      viewBox="0 0 18 18"
      width="15"
      height="15"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        class="pause-icon"
        d="M4.5 3.5H7.5V14.5H4.5ZM10.5 3.5H13.5V14.5H10.5Z"></path>
      <path class="play-icon" d="M5 3L14 9L5 15Z"></path>
    </svg>
  </button>
</figure>
<script>
  import { activateNeuron } from "./neuron-activity";
  import { decodeMicrons } from "@/data/decode-microns";
  const figure = document.querySelector<HTMLElement>("[data-neuron]");
  if (figure) {
    fetch(figure.dataset.volume!)
      .then((response) => {
        if (!response.ok) throw new Error("Neuron data unavailable");
        return response.json();
      })
      .then((data) => activateNeuron(figure, decodeMicrons(data)))
      .catch(() => {
        /* The static reconstruction remains visible. */
      });
  }
</script>
<style>
  .specimen {
    margin: 0;
    min-width: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .stimulus {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 0;
    background: #000;
    cursor: grab;
    touch-action: pan-y pinch-zoom;
    -webkit-tap-highlight-color: transparent;
  }
  .stimulus:focus-visible {
    outline-offset: -4px;
  }
  .stimulus:active {
    cursor: grabbing;
  }
  .stimulus:disabled {
    cursor: default;
  }
  .volume-poster,
  canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .volume-poster {
    object-fit: cover;
  }
  @media (min-width: 761px) {
    .volume-poster {
      transform: translateX(8%);
    }
  }
  canvas {
    visibility: hidden;
  }
  .ready .volume-activity,
  .with-gpu .volume-geometry {
    visibility: visible;
  }
  .ready .volume-poster {
    visibility: hidden;
  }
  .playback {
    position: absolute;
    z-index: 3;
    right: clamp(1rem, 4vw, 3.5rem);
    bottom: clamp(1rem, 3.5vw, 2rem);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid #fff6;
    border-radius: 50%;
    color: #fff;
    background: #08090d99;
    cursor: pointer;
  }
  .playback:hover,
  .playback:focus-visible {
    background: #1e1e27;
    border-color: #fff;
  }
  .play-icon,
  .playback[data-paused] .pause-icon {
    display: none;
  }
  .playback[data-paused] .play-icon {
    display: initial;
  }
</style>
