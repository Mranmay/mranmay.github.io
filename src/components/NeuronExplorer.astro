---
import { apical, basal } from "@/data/dendrites";
const compartments = [
  { name: "apical", arbor: apical },
  { name: "basal", arbor: basal },
];
---

<figure class="specimen">
  <svg
    class="neuron"
    viewBox="0 0 620 420"
    role="img"
    aria-label="Illustrated pyramidal neuron. A long apical trunk branches above the soma, while basal dendrites spread around its base."
  >
    <defs>
      <pattern
        id="field-dots"
        width="18"
        height="18"
        patternUnits="userSpaceOnUse"
        ><circle cx="1" cy="1" r=".8" fill="#91af9e" opacity=".35"
        ></circle></pattern
      >
      <radialGradient id="field-mask"
        ><stop offset="50%" stop-color="white"></stop><stop
          offset="100%"
          stop-color="black"></stop></radialGradient
      >
      <mask id="dots-mask"
        ><ellipse cx="315" cy="201" rx="295" ry="210" fill="url(#field-mask)"
        ></ellipse></mask
      >
    </defs>
    <rect
      width="620"
      height="420"
      fill="url(#field-dots)"
      mask="url(#dots-mask)"></rect>
    {
      compartments.map(({ name, arbor }) => (
        <g
          class={`arbor ${name}`}
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
        >
          {arbor.paths.map((d, i) => (
            <path d={d} stroke-width={0.8 + i * 0.48} />
          ))}
          {arbor.tips.map(({ x, y }) => (
            <circle cx={x} cy={y} r="1.4" fill="currentColor" stroke="none" />
          ))}
        </g>
      ))
    }
    <path
      class="arbor apical"
      fill="currentColor"
      d="M285 269Q297 246 305 218T318 179Q323 159 333 143L338 126Q337 143 332 151T321 181Q316 204 309 223T297 265Z"
    ></path>
    <path
      class="axon"
      d="M292 269Q304 300 298 327T306 372Q312 383 308 405M299 322Q309 337 326 343T347 356"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"></path>
    <path
      class="soma"
      d="M286 259Q294 249 301 241Q297 257 304 265Q307 269 314 273Q302 272 296 278Q291 278 289 274Q283 268 274 270Q280 265 286 259Z"
    ></path>
    <g class="neuron-labels" fill="none" stroke-width="1">
      <g class="arbor apical"
        ><path d="M401 115 480 66h74"></path><circle cx="401" cy="115" r="2"
        ></circle><text x="485" y="58">Apical tuft</text></g
      >
      <g class="arbor basal"
        ><path d="m379 291 86 64h119"></path><circle cx="379" cy="291" r="2"
        ></circle><text x="470" y="347">Basal dendrites</text></g
      >
      <g class="soma-label"
        ><path d="m281 256-65-32h-103"></path><text x="113" y="217">Soma</text
        ></g
      >
    </g>
  </svg>
  <figcaption>
    <span class="specimen-name">Pyramidal cell <span> / </span> schematic</span>
    <fieldset class="segments">
      <legend class="sr-only">Highlight a dendritic compartment</legend>
      {
        ["Whole cell", "Apical", "Basal"].map((label, i) => (
          <label>
            <>
              <input
                type="radio"
                name="compartment"
                value={["all", "apical", "basal"][i]}
                checked={i === 0}
              />
              <span>{label}</span>
            </>
          </label>
        ))
      }
    </fieldset>
  </figcaption>
</figure>
<style>
  .specimen {
    margin: 0;
    min-width: 0;
    align-self: center;
    color: #b5c5b8;
  }
  .neuron {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .apical {
    color: #ebbd83;
  }
  .basal {
    color: #a7c9b1;
  }
  .axon {
    color: #92a38f;
  }
  .soma {
    fill: #f2cc94;
  }
  .neuron-labels path,
  .neuron-labels circle {
    stroke: currentColor;
    opacity: 0.6;
  }
  .neuron-labels text {
    font: 14px var(--mono);
    fill: currentColor;
  }
  .soma-label {
    color: #bac5af;
  }
  .arbor {
    transition: opacity 0.18s;
  }
  .specimen:has(input[value="apical"]:checked) .basal,
  .specimen:has(input[value="basal"]:checked) .apical {
    opacity: 0.13;
  }
  figcaption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .specimen-name {
    font: 0.78rem var(--mono);
  }
  .specimen-name span {
    margin-inline: 0.25em;
    color: #819383;
  }
  .segments {
    display: inline-flex;
    border: 1px solid #55695d;
    padding: 2px;
    border-radius: 4px;
  }
  .segments label {
    position: relative;
    cursor: pointer;
  }
  .segments span {
    display: inline-block;
    padding: 0.28rem 0.55rem;
    font-size: 0.78rem;
    border-radius: 2px;
  }
  .segments input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .segments input:checked + span {
    background: #c4d2be;
    color: #15251b;
  }
  .segments input:focus-visible + span {
    outline: 2px solid white;
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .arbor {
      transition: none;
    }
  }
  @media (max-width: 760px) {
    .specimen {
      display: grid;
      justify-items: center;
      width: 100%;
    }
    .neuron {
      height: clamp(9rem, 24svh, 13rem);
      width: auto;
      max-width: 100%;
    }
    .neuron-labels {
      display: none;
    }
    figcaption {
      gap: 0.5rem 1rem;
    }
  }
</style>
