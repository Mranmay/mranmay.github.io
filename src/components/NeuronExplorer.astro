---
import volumeUrl from "@/data/microns-volume.json?url";
---

<figure
  class="specimen"
  data-neuron
  data-volume={volumeUrl}
  aria-label="Interactive MICrONS mouse visual cortex reconstruction"
>
  <button
    type="button"
    class="stimulus"
    aria-label="Stimulate a neuron. Drag horizontally to rotate the reconstruction."
    disabled
  >
    <span class="volume-poster" aria-hidden="true"></span>
    <canvas class="volume-geometry" aria-hidden="true"></canvas>
    <canvas class="volume-activity" aria-hidden="true"></canvas>
  </button>
  <button
    type="button"
    class="playback"
    aria-label="Pause animation"
    title="Pause animation"
    hidden
  >
    <svg
      viewBox="0 0 18 18"
      width="15"
      height="15"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        class="pause-icon"
        d="M4.5 3.5H7.5V14.5H4.5ZM10.5 3.5H13.5V14.5H10.5Z"></path>
      <path class="play-icon" d="M5 3L14 9L5 15Z"></path>
    </svg>
  </button>
</figure>
<script>
  import { activateNeuron } from "./neuron-activity";
  import { decodeMicrons } from "@/data/decode-microns";
  const figure = document.querySelector<HTMLElement>("[data-neuron]");
  if (figure) {
    fetch(figure.dataset.volume!)
      .then((response) => {
        if (!response.ok) throw new Error("Neuron data unavailable");
        return response.json();
      })
      .then((data) => activateNeuron(figure, decodeMicrons(data)))
      .catch(() => {
        /* The static reconstruction remains visible. */
      });
  }
</script>
<style>
  .specimen {
    --field-matte: #000;
    --poster-position: 50%;
    --portrait-zoom: 1;
    --control-ink: #fff;
    --control-bg: #0a0a0c99;
    --control-border: #fff6;
    margin: 0;
    min-width: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  :global([data-theme="light"]) .specimen {
    --field-matte: #fff;
    --control-ink: #29272c;
    --control-bg: #ffffffb8;
    --control-border: #24202d55;
  }
  .stimulus {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 0;
    background: var(--field-matte);
    cursor: grab;
    touch-action: pan-y pinch-zoom;
    -webkit-tap-highlight-color: transparent;
  }
  .stimulus:focus-visible {
    outline-offset: -4px;
  }
  .stimulus:active {
    cursor: grabbing;
  }
  .stimulus:disabled {
    cursor: default;
  }
  .volume-poster,
  canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .volume-poster {
    background: var(--field-matte) url("/images/microns-tissue-dark.webp")
      var(--poster-position) center/cover no-repeat;
    background-image: image-set(
      url("/images/microns-tissue-dark.avif") type("image/avif"),
      url("/images/microns-tissue-dark.webp") type("image/webp")
    );
  }
  :global([data-theme="light"]) .volume-poster {
    background-image: url("/images/microns-tissue-light.webp");
    background-image: image-set(
      url("/images/microns-tissue-light.avif") type("image/avif"),
      url("/images/microns-tissue-light.webp") type("image/webp")
    );
  }
  @media (max-width: 760px) and (orientation: portrait) {
    .specimen {
      --poster-position: 67%;
      --portrait-zoom: 1.24;
    }
    .volume-poster {
      background-size: auto 124%;
    }
    .volume-poster,
    canvas {
      transform: translateY(-33%);
      mask-image: linear-gradient(to bottom, #000 76%, transparent 100%);
    }
  }
  canvas {
    visibility: hidden;
  }
  .ready .volume-activity,
  .with-gpu .volume-geometry {
    visibility: visible;
  }
  .ready:not(.poster-active) .volume-poster {
    display: none;
  }
  .playback {
    position: absolute;
    z-index: 3;
    right: clamp(1rem, 4vw, 3.5rem);
    bottom: clamp(1rem, 3.5vw, 2rem);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--control-border);
    border-radius: 50%;
    color: var(--control-ink);
    background: var(--control-bg);
    cursor: pointer;
  }
  .playback:hover,
  .playback:focus-visible {
    background: var(--field-matte);
    border-color: var(--control-ink);
  }
  .play-icon,
  .playback[data-paused] .pause-icon {
    display: none;
  }
  .playback[data-paused] .play-icon {
    display: initial;
  }
</style>
