---
import volumeUrl from "@/data/microns-volume.json?url";
---

<figure
  class="specimen"
  data-neuron
  data-volume={volumeUrl}
  aria-label="Interactive MICrONS mouse visual cortex reconstruction"
>
  <button
    type="button"
    class="stimulus"
    aria-label="Stimulate a neuron. Drag horizontally to rotate the reconstruction."
    disabled
  >
    <span class="field" aria-hidden="true">
      <span class="volume-poster"></span>
      <canvas class="volume-geometry"></canvas>
      <canvas class="volume-activity"></canvas>
    </span>
  </button>
  <button
    type="button"
    class="playback"
    aria-label="Pause animation"
    title="Pause animation"
    hidden
  >
    <svg
      viewBox="0 0 18 18"
      width="15"
      height="15"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        class="pause-icon"
        d="M4.5 3.5H7.5V14.5H4.5ZM10.5 3.5H13.5V14.5H10.5Z"></path>
      <path class="play-icon" d="M5 3L14 9L5 15Z"></path>
    </svg>
  </button>
</figure>
<script>
  import type { activateNeuron } from "./neuron-activity";

  type Scene = NonNullable<Awaited<ReturnType<typeof activateNeuron>>>;
  function bind(figure: HTMLElement) {
    const trigger = figure.querySelector<HTMLButtonElement>(".stimulus")!;
    const playback = figure.querySelector<HTMLButtonElement>(".playback")!;
    const field = figure.querySelector<HTMLElement>(".field")!;
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    let scene: Scene | undefined, loading: Promise<void> | undefined;
    let shown = true, paused = false, moved = false;
    let yaw = 0, pitch = 0.19, rotated = false;
    let down: { x: number; y: number; yaw: number; pitch: number } | undefined;
    const taps: { x: number; y: number; time: number }[] = [];

    function start() {
      if (scene || loading) return;
      loading = Promise.all([
        import("./neuron-activity"), import("../data/decode-microns"),
        fetch(figure.dataset.volume!).then(r => {
          if (!r.ok) throw Error("Neuron data unavailable");
          return r.json();
        }),
      ]).then(async ([activity, decoder, volume]) => {
        const ready = await activity.activateNeuron(figure, await decoder.decodeMicrons(volume));
        if (!ready) return;
        scene = ready;
        scene.setPaused(paused);
        if (!document.hidden && shown) {
          if (rotated) scene.rotate(yaw, pitch);
          const latest = taps.at(-1);
          for (const tap of taps) {
            if (latest && latest.time - tap.time < 1.5) scene.tap(tap.x, tap.y, tap.time);
          }
        }
      }).catch(() => {
        // The initial tissue image remains available. The next gesture can retry.
      }).finally(() => { loading = undefined; taps.length = 0; });
    }
    function syncPlayback() {
      playback.hidden = motion.matches;
      playback.toggleAttribute("data-paused", paused);
      playback.title = paused ? "Play animation" : "Pause animation";
      playback.setAttribute("aria-label", playback.title);
      field.style.animationPlayState = (paused || !shown || document.hidden) ? "paused" : "running";
    }
    playback.addEventListener("click", () => {
      paused = !paused;
      taps.length = 0;
      scene?.setPaused(paused);
      syncPlayback();
    });
    motion.addEventListener("change", syncPlayback);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) { taps.length = 0; down = undefined; }
      syncPlayback();
    });
    new IntersectionObserver(([entry]) => {
      shown = entry.isIntersecting;
      if (!shown) { taps.length = 0; down = undefined; }
      syncPlayback();
    }).observe(figure);

    trigger.addEventListener("pointerdown", e => {
      if (!e.isPrimary || e.button !== 0) return;
      down = { x: e.clientX, y: e.clientY, yaw, pitch };
      moved = false;
      if (e.pointerType === "mouse") start();
    });
    trigger.addEventListener("pointermove", e => {
      if (!e.isPrimary || !down) return;
      const dx = e.clientX - down.x, dy = e.clientY - down.y;
      if (!moved && Math.hypot(dx, dy) < 6) return;
      if (!moved && e.pointerType === "touch" && Math.abs(dy) > Math.abs(dx)) {
        moved = true; down = undefined; return;
      }
      if (!moved) trigger.setPointerCapture(e.pointerId);
      moved = rotated = true;
      yaw = down.yaw + dx * 0.007;
      pitch = Math.max(-0.95, Math.min(0.95, down.pitch + dy * 0.005));
      if (scene) scene.rotate(yaw, pitch);
      else start();
    });
    trigger.addEventListener("pointerup", () => { down = undefined; });
    trigger.addEventListener("pointercancel", () => { down = undefined; moved = true; });
    trigger.addEventListener("lostpointercapture", () => { down = undefined; });
    trigger.addEventListener("click", e => {
      if (e.detail && moved) return;
      const rect = field.getBoundingClientRect();
      const x = e.detail ? (e.clientX - rect.left) / rect.width : -1;
      const y = e.detail ? (e.clientY - rect.top) / rect.height : -1;
      if (e.detail && (x < 0 || y < 0 || x > 1 || y > 1)) return;
      const time = performance.now() / 1000;
      if (scene) scene.tap(x, y, time);
      else {
        if (taps.length >= 5) taps.shift();
        taps.push({ x, y, time }); start();
      }
    });
    trigger.disabled = false;
    syncPlayback();
  }
  const figure = document.querySelector<HTMLElement>("[data-neuron]");
  if (figure) bind(figure);
</script>
<style>
  .specimen {
    --field-matte: #000;
    --control-ink: #fff;
    --control-bg: #0a0a0c99;
    --control-border: #fff6;
    margin: 0;
    min-width: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  :global([data-theme="light"]) .specimen {
    --field-matte: #fff;
    --control-ink: #29272c;
    --control-bg: #ffffffb8;
    --control-border: #24202d55;
  }
  .stimulus {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 0;
    background: var(--field-matte);
    cursor: grab;
    touch-action: pan-y pinch-zoom;
    -webkit-tap-highlight-color: transparent;
  }
  .stimulus:focus-visible {
    outline-offset: -4px;
  }
  .stimulus:active {
    cursor: grabbing;
  }
  .stimulus:disabled {
    cursor: default;
  }
  .field,
  .volume-poster,
  canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* The poster and click overlay move as one layer so hit testing stays aligned. */
  @keyframes tissue-drift {
    from { transform: translate(-0.45%, 0.20%) scale(1.012); }
    to { transform: translate(0.45%, -0.20%) scale(1.012); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .field { animation: tissue-drift 15s ease-in-out infinite alternate; }
  }
  .playback[hidden] { display: none; }
  .volume-poster {
    background: var(--field-matte) url("/images/microns-tissue-glow-dark.webp")
      center/cover no-repeat;
    background-image: image-set(
      url("/images/microns-tissue-glow-dark.avif") type("image/avif"),
      url("/images/microns-tissue-glow-dark.webp") type("image/webp")
    );
  }
  :global([data-theme="light"]) .volume-poster {
    background-image: url("/images/microns-tissue-luminous-light.webp");
    background-image: image-set(
      url("/images/microns-tissue-luminous-light.avif") type("image/avif"),
      url("/images/microns-tissue-luminous-light.webp") type("image/webp")
    );
  }
  canvas {
    visibility: hidden;
  }
  .specimen :global(.volume-software) {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .ready .volume-activity,
  .with-gpu .volume-geometry {
    visibility: visible;
  }
  .ready:not(.poster-active) .volume-poster {
    display: none;
  }
  .playback {
    position: absolute;
    z-index: 3;
    right: clamp(1rem, 4vw, 3.5rem);
    bottom: clamp(1rem, 3.5vw, 2rem);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--control-border);
    border-radius: 50%;
    color: var(--control-ink);
    background: var(--control-bg);
    cursor: pointer;
  }
  .playback:hover,
  .playback:focus-visible {
    background: var(--field-matte);
    border-color: var(--control-ink);
  }
  @media (max-width: 760px) {
    .playback {
      right: 0.75rem;
      bottom: 2.5rem;
    }
  }
  .play-icon,
  .playback[data-paused] .pause-icon {
    display: none;
  }
  .playback[data-paused] .play-icon {
    display: initial;
  }
</style>
