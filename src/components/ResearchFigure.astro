---
interface Props {
  figure: {
    src: string;
    width: number;
    height: number;
    alt: string;
    caption: string;
    credit: string;
    source?: string;
    license?: { label: string; url: string };
    photoCredits?: string;
  };
  title: string;
}
const { figure, title } = Astro.props;
---

<figure itemscope itemtype="https://schema.org/ImageObject">
  <meta itemprop="caption" content={figure.caption} />
  <meta itemprop="creditText" content={figure.credit} />
  {figure.source && <link itemprop="isBasedOn" href={figure.source} />}
  {figure.license && <link itemprop="license" href={figure.license.url} />}
  {figure.photoCredits && <link itemprop="citation" href={figure.photoCredits} />}
  <a class="figure-image" href={figure.src} aria-label={`Open full-size figure: ${title}`}>
    <img itemprop="contentUrl" src={figure.src} width={figure.width} height={figure.height} alt={figure.alt} loading="lazy" decoding="async" />
  </a>
</figure>
<style>
  figure { margin: 0; }
  .figure-image {
    display: grid;
    align-items: center;
    justify-items: center;
    background: #fff;
    border-radius: 3px;
    padding: .45rem;
    cursor: zoom-in;
  }
  .figure-image img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 25rem;
    object-fit: contain;
  }
</style>
