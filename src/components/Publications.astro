---
import { FULL_NAME } from "@/consts";
import { papers, featuredPaperIds } from "@/data/papers";
import { paperFigures } from "@/data/paperFigures";
---

<section class="shell home-section publications" id="publications" aria-labelledby="publications-heading">
  <div class="section-head">
    <h2 id="publications-heading">Selected publications</h2>
    <a class="text-link" href="/research/">All research</a>
  </div>
  <ul class="paper-list">
    {featuredPaperIds.map((id) => {
      const paper = papers[id];
      const figure = paperFigures[id];
      const [before, after] = paper.authors.split(FULL_NAME);
      return (
        <li>
          <figure itemscope itemtype="https://schema.org/ImageObject">
            <meta itemprop="creditText" content={figure.credit} />
            <link itemprop="license" href={figure.license.url} />
            {"photoCredits" in figure && <link itemprop="citation" href={figure.photoCredits} />}
            <a href={figure.source} itemprop="isBasedOn" class="paper-image" aria-label={`View the original figure from ${paper.title}`} title={`${figure.credit} · ${figure.license.label}`}>
              <img itemprop="contentUrl" src={figure.src} alt={figure.alt} width={figure.width} height={figure.height} loading="lazy" decoding="async" />
            </a>
          </figure>
          <div class="paper-citation">
            <p class="paper-meta">{paper.venue} <span>·</span> {paper.year}</p>
            <h3><a href={paper.href}>{paper.title}</a></h3>
            <p class="authors">{before}<strong>{FULL_NAME}</strong>{after}</p>
            <p class="paper-result">{paper.result}</p>
          </div>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .paper-list {
    padding: 0;
    margin: 1.45rem 0 0;
    list-style: none;
  }
  .paper-list li {
    display: grid;
    grid-template-columns: minmax(9rem, .31fr) minmax(0, 1fr);
    gap: clamp(1.2rem, 3.2vw, 2.8rem);
    border-top: 1px solid var(--rule);
    padding-block: 1.5rem;
    align-items: center;
  }
  .paper-image {
    display: grid;
    place-items: center;
    aspect-ratio: 1.65;
    background: #fff;
    border: 1px solid var(--rule);
    overflow: hidden;
    border-radius: 4px;
    padding: .4rem;
  }
  .paper-image img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }
  .paper-meta {
    color: var(--accent);
    font: .86rem/1.45 var(--mono);
    margin-bottom: .4rem;
  }
  .paper-meta span {
    color: var(--muted);
  }
  .paper-citation h3 {
    font-size: clamp(1.4rem, 2.15vw, 1.95rem);
    line-height: 1.18;
    text-wrap: pretty;
  }
  .paper-citation h3 a {
    text-decoration: none;
  }
  .paper-citation h3 a:hover, .paper-citation h3 a:focus-visible {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: .14em;
    text-decoration-thickness: 1px;
  }
  .authors {
    font-size: .9rem;
    color: var(--muted);
    line-height: 1.5;
    margin-top: .4rem;
  }
  .authors strong {
    color: var(--ink);
    font-weight: 600;
  }
  .paper-result {
    margin-top: .5rem;
    max-width: 70ch;
    line-height: 1.48;
    color: var(--ink);
  }
  @media (max-width: 640px) {
    .publications .section-head {
      flex-wrap: wrap;
      align-items: baseline;
      gap: .3rem 1rem;
    }
    .paper-list li {
      grid-template-columns: minmax(6.5rem, .8fr) minmax(0, 1.5fr);
      align-items: start;
      gap: .6rem 1rem;
      padding-block: 1.1rem;
    }
    .paper-image {
      aspect-ratio: 1.28;
    }
    .paper-citation {
      display: contents;
    }
    .paper-list figure {
      grid-column: 1;
      grid-row: 1 / 3;
    }
    .paper-meta, .paper-citation h3 {
      grid-column: 2;
    }
    .paper-meta {
      align-self: end;
      margin: 0;
      font-size: .8rem;
    }
    .paper-citation h3 {
      font-size: 1.35rem;
    }
    .authors, .paper-result {
      grid-column: 1 / -1;
      margin: 0;
    }
  }
  @media (max-width: 380px) {
    .paper-list li {
      gap: .6rem .7rem;
    }
    .paper-citation h3 {
      font-size: 1.25rem;
    }
  }
</style>
