---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import Publications from "@/components/Publications.astro";
import { getCollection } from "astro:content";
import BlogPostCard from "@/components/BlogPostCard.astro";
const posts = (await getCollection("blog")).sort(
  (a, b) => +b.data.pubDate - +a.data.pubDate,
);
---

<Layout title="Mranmay Shetty | Computational Neuroscience">
  <Hero />
  <Publications />
  {
    posts.length > 0 && (
      <section
        class="shell home-section writing-section"
        aria-labelledby="writing-title"
      >
        <div class="section-head">
          <>
            <h2 id="writing-title">Blog</h2>
            <a class="text-link" href="/blog/">
              All posts
            </a>
          </>
        </div>
        <div class="home-posts">
          {posts.slice(0, 3).map((post) => <BlogPostCard post={post} />)}
        </div>
      </section>
    )
  }
</Layout>
