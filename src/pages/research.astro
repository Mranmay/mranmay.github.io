---
import type { ComponentProps } from "astro/types";
import Layout from "@/layouts/Layout.astro";
import { projects, type ProjectId } from "@/data/projects";
import { paperFigures } from "@/data/paperFigures";
import { researchFigures } from "@/data/researchFigures";
import ResearchFigure from "@/components/ResearchFigure.astro";

type Figure = ComponentProps<typeof ResearchFigure>["figure"];

const figures: Partial<Record<ProjectId, Figure>> = {
  ...researchFigures,
  "visual-memory": {
    ...paperFigures.dejaView,
    caption: "During each trial, the model reads its memory before it updates it with the current image.",
  },
};

const sections = [
  { id: "ongoing", label: "Ongoing research", projects: projects.filter((project) => project.status === "Ongoing") },
  { id: "completed", label: "Completed projects", projects: projects.filter((project) => project.status === "Completed") },
];
---

<Layout
  title="Research | Mranmay Shetty"
  description="Projects on dendritic connectivity, calcium imaging, visual working memory and retinal computation."
>
  <div class="shell inner-page research-page">
    <header class="research-intro">
      <h1>Research</h1>
      <nav class="jump-links" aria-label="Research sections">
        {sections.map((section) => <a href={`#${section.id}`}>{section.label}</a>)}
      </nav>
    </header>
    {sections.map((section) => (
      <section id={section.id} class="research-section" aria-labelledby={`${section.id}-heading`}>
        <h2 id={`${section.id}-heading`}>{section.label}</h2>
        {section.projects.map((project) => {
          const figure = figures[project.id];
          return (
            <article class="research-project" id={project.id} aria-labelledby={`${project.id}-title`}>
              <header class="project-title">
                <p>{project.group}</p>
                <h3 id={`${project.id}-title`}>{project.title}</h3>
              </header>
              <div class="project-copy">
                <p class="question">{project.question}</p>
                <p>{project.approach}</p>
                <p>{project.detail}</p>
                <div class="project-links">
                  {project.links.map((link) => <a class="text-link" href={link.href}>{link.label}</a>)}
                </div>
              </div>
              {figure && (
                <div class="project-figure">
                  <ResearchFigure figure={figure} title={project.title} />
                </div>
              )}
            </article>
          );
        })}
      </section>
    ))}
  </div>
</Layout>

<style>
  .research-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(2.6rem, 6vw, 5.5rem);
  }
  .research-intro nav { margin: 0; }
  .research-section + .research-section { margin-top: clamp(2.6rem, 5vw, 4.8rem); }
  .research-section h2 {
    font-size: clamp(2.2rem, 3.8vw, 3.6rem);
    line-height: 1.1;
    margin-bottom: 1rem;
  }
  .research-project {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr);
    grid-template-areas:
      "title figure"
      "copy figure";
    column-gap: clamp(1.8rem, 5vw, 5.5rem);
    grid-template-rows: auto 1fr;
    border-top: 1px solid var(--rule);
    padding-block: clamp(1.8rem, 3.7vw, 3.8rem);
  }
  .project-title { grid-area: title; }
  .project-title p {
    color: var(--muted);
    font: .87rem/1.5 var(--mono);
    margin-block-end: .5rem;
  }
  .project-title h3 {
    font-size: clamp(1.9rem, 3.5vw, 3.2rem);
    line-height: 1.05;
    letter-spacing: -.02em;
    text-wrap: balance;
  }
  .project-copy {
    grid-area: copy;
    margin-block-start: .9rem;
    max-width: 65ch;
  }
  .project-copy p {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.6;
  }
  .project-copy .question { color: var(--ink); font-size: 1.16rem; line-height: 1.46; }
  .project-copy p + p { margin-block-start: .75rem; }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem 1.5rem;
    margin-block-start: 1.1rem;
  }
  .project-figure { grid-area: figure; align-self: start; margin: 0; }
  @media (max-width: 750px) {
    .research-project {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "title" "copy" "figure";
    }
    .project-figure { margin-top: 1.3rem; }
  }
</style>
