---
import Layout from "@/layouts/Layout.astro";
import ProjectArt from "@/components/ProjectArt.astro";
import { projects } from "@/data/projects";

const ongoing = projects.filter((project) => project.status === "Ongoing");
const completed = projects.filter((project) => project.status === "Completed");
---

<Layout
  title="Research | Mranmay Shetty"
  description="Ongoing work on dendritic connectivity in mouse visual cortex and previous projects on visual memory, spike inference, retinal models and machine perception."
>
  <div class="shell inner-page research-page">
    <h1>Research</h1>
    <nav class="jump-links" aria-label="Research sections">
      <a href="#ongoing">Ongoing work</a>
      <a href="#completed">Completed projects &amp; papers</a>
    </nav>
    <section id="ongoing" aria-labelledby="ongoing-heading">
      <h2 id="ongoing-heading">Ongoing work</h2>
      {ongoing.map((project) => (
        <article class="ongoing-project" id={project.id}>
          <div class="ongoing-illustration">
            <ProjectArt id={project.id} />
            <p class="diagram-caption">Schematic of overlapping receptive fields</p>
          </div>
          <div class="project-copy">
            <p class="meta">{project.group}</p>
            <h3>{project.title}</h3>
            <p class="question">{project.question}</p>
            <p>{project.approach}</p>
            <p>{project.detail}</p>
            <a class="text-link" href="https://www.microns-explorer.org/">Explore the MICrONS dataset</a>
          </div>
        </article>
      ))}
    </section>
    <section id="completed" aria-labelledby="completed-heading">
      <h2 id="completed-heading">Completed projects &amp; papers</h2>
      {completed.map((project) => (
        <article class="past-project" id={project.id}>
          <div class="project-meta">
            <p>{project.field}</p>
            <p>{project.group}</p>
          </div>
          <div class="project-copy">
            <h3>{project.title}</h3>
            <p class="question">{project.question}</p>
            <p>{project.approach}</p>
            {"detail" in project && <p>{project.detail}</p>}
            {"note" in project && <p><a class="text-link" href={project.note.href}>{project.note.title}</a></p>}
            {"paper" in project && (
              <p class="paper-reference">
                <span>{project.paper.venue} · {project.paper.year}</span>
                <a class="text-link" href={project.paper.href}>{project.paper.title}</a>
              </p>
            )}
          </div>
        </article>
      ))}
    </section>
  </div>
</Layout>

<style>
  .research-page h2 {
    font-size: clamp(2.2rem, 3.8vw, 3.6rem);
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }
  #completed {
    margin-top: clamp(2.8rem, 6vw, 5rem);
  }
  .ongoing-project, .past-project {
    display: grid;
    grid-template-columns: minmax(11rem, .52fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 4.4vw, 4rem);
    align-items: start;
    border-top: 1px solid var(--rule);
    padding-block: 1.55rem;
  }
  .ongoing-illustration :global(.project-art) {
    aspect-ratio: 1.85;
    display: grid;
    align-items: center;
  }
  .diagram-caption {
    color: var(--muted);
    margin-top: .45rem;
    font-size: .83rem;
  }
  .project-meta p:first-child {
    color: var(--ink);
    font-size: 1.05rem;
    margin-bottom: .3rem;
  }
  .project-meta, .project-copy p:not(.question) {
    color: var(--muted);
  }
  .project-copy h3 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    line-height: 1.12;
  }
  .project-copy > * + * {
    margin-top: .7rem;
  }
  .project-copy .question {
    font-size: 1.14rem;
  }
  .project-copy > a, .paper-reference span {
    display: inline-block;
  }
  .paper-reference span {
    display: block;
    margin: 1rem 0 .25rem;
    font: .85rem/1.45 var(--mono);
  }
  @media (max-width: 680px) {
    .ongoing-project, .past-project {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .ongoing-illustration :global(.project-art) {
      aspect-ratio: 2.8;
    }
    .project-meta p:first-child {
      margin-bottom: 0;
    }
  }
</style>
