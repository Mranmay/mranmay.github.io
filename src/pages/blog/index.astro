---
import { getCollection } from "astro:content";
import BlogPostCard from "@/components/BlogPostCard.astro";
import Layout from "@/layouts/Layout.astro";
const posts = (await getCollection("blog")).sort(
  (a, b) => +b.data.pubDate - +a.data.pubDate,
);
---

<Layout
  title="Blog | Mranmay Shetty"
  description="Essays and research notes on neuroscience, computation and mathematics."
>
  <div class="shell inner-page">
    <h1>Blog</h1>
    <p class="lead">
      Longer notes on neuroscience, computation, and questions I’ve followed
      into the mathematics.
    </p>
    <div class="post-list">
      {posts.map((post) => <BlogPostCard post={post} />)}
    </div>
  </div>
</Layout>
