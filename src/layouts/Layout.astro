---
import BaseHead from "@/components/BaseHead.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/consts";
const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <script is:inline>
      try {
        if (localStorage.getItem("theme") === "light")
          document.documentElement.dataset.theme = "light";
      } catch {}
    </script>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <script is:inline>
      (() => {
        const viewport = window.visualViewport;
        if (!viewport || !matchMedia("(any-pointer: coarse)").matches) return;
        const root = document.documentElement;
        function syncWidth() {
          // Some tablet browsers update the visible viewport before the layout viewport.
          if (Math.abs(viewport.scale - 1) > 0.01) return;
          const width = Math.round(viewport.width);
          if (width > root.clientWidth + 1) root.style.setProperty("--rotation-width", width + "px");
          else root.style.removeProperty("--rotation-width");
        }
        viewport.addEventListener("resize", syncWidth);
        window.addEventListener("resize", syncWidth);
        window.addEventListener("pageshow", syncWidth);
        syncWidth();
      })();
    </script>
    <a href="#main" class="skip-link">Skip to content</a>
    <header><Navbar /></header>
    <main id="main"><slot /></main>
    <footer><Footer /></footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.getElementById("theme-toggle");
        function apply(light) {
          root.dataset.theme = light ? "light" : "dark";
          button.setAttribute("aria-pressed", String(light));
        }
        apply(root.dataset.theme === "light");
        button.hidden = false;
        button.addEventListener("click", () => {
          apply(root.dataset.theme !== "light");
          try {
            localStorage.setItem("theme", root.dataset.theme);
          } catch {}
        });
        window.addEventListener("storage", (event) => {
          if (event.key === "theme" || event.key === null)
            apply(event.newValue === "light");
        });
        window.addEventListener("pageshow", (event) => {
          if (event.persisted) {
            try {
              apply(localStorage.getItem("theme") === "light");
            } catch {}
          }
        });
      })();
    </script>
  </body>
</html>
