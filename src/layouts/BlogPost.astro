---
import type { CollectionEntry } from "astro:content";
import DateLabel from "@/components/Date.astro";
import Layout from "@/layouts/Layout.astro";
import "katex/dist/katex.min.css";
type Props = CollectionEntry<"blog">["data"];
const {
  title,
  description,
  author,
  pubDate,
  heroImage,
  heroImageAlt,
  tags,
} = Astro.props;
---

<Layout title={`${title} | Mranmay Shetty`} description={description}>
  <article class="shell inner-page post-page">
    <a class="text-link" href="/blog/">All posts</a>
    <div class="article-heading">
      <p class="meta">
        <DateLabel date={pubDate} />{author && <> · {author}</>}
      </p>
      <h1>{title}</h1><p class="lead">{description}</p>
      {
        tags?.length && (
          <ul class="tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
      {
        heroImage && (
          <img class="post-cover" src={heroImage} alt={heroImageAlt ?? ""} />
        )
      }
    </div>
    <div class="article-body"><slot /></div>
  </article>
</Layout>
